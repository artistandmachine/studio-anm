{
  "color": {
    "accent": { "$value": "{brand.primary}", "$type": "color", "$description": "primary accent for links, highlights, etc." },
    "on-surface": { "$value": "var(--color-black)", "$type": "color", "$description": "text/icons on `surface`" },
    "surface": { "$value": "var(--color-white)", "$type": "color", "$description": "main page/component background" },
    "primary-container": { "$value": "var(--color-black)", "$type": "color", "$description": "footer background, and any other dark band behind light text/icons" },
    "on-primary-container": { "$value": "var(--color-white)", "$type": "color", "$description": "text/icons on `primary-container`" },
    "surface-variant": { "$value": "{brand.secondary}", "$type": "color", "$description": "outer page letterbox behind the main content column" },
    "on-surface-variant": { "$value": "{brand.tertiary}", "$type": "color", "$description": "muted fg, e.g. the footer's wordmark/email divider" },
    "skeleton-fill": { "$value": "var(--color-neutral-100)", "$type": "color", "$description": "media placeholder fill; intentionally constant across themes — not overridden in theme.dark.json" },
    "border-sm": { "$value": "#70665c4d", "$type": "color", "$description": "section (Intro/WorkGrid/About) scroll progress bar track" },
    "progress-sm": { "$value": "var(--color-black)", "$type": "color", "$description": "section scroll progress bar fill" },
    "border-lg": { "$value": "var(--color-black)", "$type": "color", "$description": "Nav page-load progress bar track" },
    "progress-lg": { "$value": "{brand.tertiary}", "$type": "color", "$description": "Nav page-load progress bar fill" }
  }
}
